# Persistence for agent memory.
#
# Leave BOTH unset for local dev — memory persists to a local SQLite file (./playground.db).
#
# On a serverless host (Vercel), the filesystem is ephemeral, so point at a remote libSQL/Turso
# database instead (free tier is plenty). Create one at https://turso.tech and paste the values:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# NOTE: there is no LLM API key here. The playground is bring-your-own-key — each visitor enters
# their own OpenAI/Anthropic key in the UI; it is sent per-request, used server-side, and never
# stored or logged. (That's why this repo is public — you can verify it.)
